.vscode/**
.github/**
.superpowers/**
docs/**
# …but the user guides the README links to.
!docs/user-guide.md
!docs/user-guide.vi.md
src/**
test/**
scripts/**
esbuild.js
eslint.config.mjs
tsconfig.json
bunfig.toml
.prettierrc
.prettierignore
.gitignore
.codegraph
# CI-only leftovers: release-please's files, and the prebuilt Linux binaries the packaging job
# downloads into the checkout (scripts/package-target.mjs adds the one target's own prebuild back).
release-please-config.json
.release-please-manifest.json
linux-prebuilds/**
**/*.map
**/*.ts
*.vsix
bun.lock
package-lock.json

.vscode-test/**
dist-test/**

# node_modules: opt-in only. Everything the extension needs at runtime is bundled by esbuild
# except node-pty (native) and xterm's stylesheet, which the webview loads as a file.
node_modules/**
!node_modules/node-pty/package.json
!node_modules/node-pty/lib/**/!(*.map)
!node_modules/node-pty/prebuilds/**
!node_modules/@xterm/xterm/css/xterm.css
.playwright-mcp/**
